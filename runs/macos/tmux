#!/usr/bin/env bash
set -euo pipefail

if ! command -v tmux >/dev/null 2>&1; then
    if ! command -v brew >/dev/null 2>&1; then
        echo "Homebrew is required to install tmux on macOS" >&2
        exit 1
    fi
    brew install tmux
fi

mkdir -p "$HOME/.config/tmux"

cat > "$HOME/.config/tmux/status-metrics" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

cpu_macos() {
    LC_ALL=C top -l 1 -n 0 | awk -F'[:,%]' '/CPU usage/ {
        user = $2
        sys = $4
        gsub(/[^0-9.]/, "", user)
        gsub(/[^0-9.]/, "", sys)
        printf "%.0f", user + sys
        exit
    }'
}

mem_macos() {
    local page_size total_bytes
    page_size="$(vm_stat | awk '/page size of/ { print $8 }')"
    total_bytes="$(sysctl -n hw.memsize)"
    vm_stat | awk -v page_size="$page_size" -v total_bytes="$total_bytes" '
        /Pages active/ { active = $3 }
        /Pages wired down/ { wired = $4 }
        /Pages occupied by compressor/ { compressed = $5 }
        END {
            gsub(/\./, "", active)
            gsub(/\./, "", wired)
            gsub(/\./, "", compressed)
            used = (active + wired + compressed) * page_size
            printf "%.0f", (used / total_bytes) * 100
        }'
}

printf 'CPU %s%% - MEM %s%%' "$(cpu_macos 2>/dev/null || printf 0)" "$(mem_macos 2>/dev/null || printf 0)"
SCRIPT
chmod +x "$HOME/.config/tmux/status-metrics"

host="$(hostname -s 2>/dev/null || hostname)"
label="${TMUX_HOST_LABEL:-$host}"
accent="${TMUX_ACCENT:-#e5e7eb}"
accent_fg="${TMUX_ACCENT_FG:-#111827}"
bar_bg="${TMUX_BAR_BG:-#171717}"
text="${TMUX_TEXT:-#d1d5db}"
dim="${TMUX_DIM:-#6b7280}"
left_len="${TMUX_STATUS_LEFT_LENGTH:-48}"

if [[ -e "$HOME/.tmux.conf" || -L "$HOME/.tmux.conf" ]]; then
    backup_base="$HOME/.tmux.conf.codex-backup-$(date +%Y%m%d%H%M%S)"
    backup_path="$backup_base"
    backup_suffix=0
    while [[ -e "$backup_path" || -L "$backup_path" ]]; do
        backup_suffix=$((backup_suffix + 1))
        backup_path="$backup_base-$backup_suffix"
    done
    cp -p "$HOME/.tmux.conf" "$backup_path"
    printf 'Backed up existing tmux config to %s\n' "$backup_path"
fi

cat > "$HOME/.tmux.conf" <<TMUX
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",xterm-256color:Tc"
set -g mouse on
set -g status on
set -g status-position bottom
set -g status-interval 5
set -g status-justify left
set -g status-left-length $left_len
set -g status-right-length 48

set -g @codex_host_label "$label"
set -g @codex_accent "$accent"
set -g @codex_accent_fg "$accent_fg"
set -g @codex_bar_bg "$bar_bg"
set -g @codex_text "$text"
set -g @codex_dim "$dim"

set -g status-style "fg=#{@codex_text},bg=#{@codex_bar_bg}"
set -g status-left "#[fg=#{@codex_accent_fg},bg=#{@codex_accent},bold] #{@codex_host_label} #[fg=#{@codex_text},bg=#{@codex_bar_bg},bold] #S "
set -g status-right "#[fg=#{@codex_accent_fg},bg=#{@codex_accent},bold] #($HOME/.config/tmux/status-metrics) "
set -g window-status-separator ""
set -g window-status-format "#[fg=#{@codex_dim},bg=#{@codex_bar_bg}] #I:#W "
set -g window-status-current-format "#[fg=#{@codex_accent},bg=#{@codex_bar_bg},bold] #I:#W "
set -g message-style "fg=#{@codex_accent_fg},bg=#{@codex_accent}"
set -g mode-style "fg=#{@codex_accent_fg},bg=#{@codex_accent}"
TMUX

if [[ -f "$HOME/.zshrc" ]] && ! grep -q 'codex auto tmux on ssh' "$HOME/.zshrc"; then
    cp "$HOME/.zshrc" "$HOME/.zshrc.codex-backup-$(date +%Y%m%d%H%M%S)"
    cat >> "$HOME/.zshrc" <<'ZSHRC'

# >>> codex auto tmux on ssh >>>
# Attach SSH logins to a persistent tmux session so disconnects can resume.
if [[ -o interactive && -n ${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-} && -z ${TMUX:-} && -z ${NO_AUTO_TMUX:-} && -t 1 ]]; then
    tmux_bin="${commands[tmux]:-/opt/homebrew/bin/tmux}"
    if [[ -x "$tmux_bin" ]]; then
        exec "$tmux_bin" new-session -A -s main
    fi
    unset tmux_bin
fi
# <<< codex auto tmux on ssh <<<
ZSHRC
fi

tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
