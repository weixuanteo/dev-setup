# Copy this file and pass it to ./install-t3code --env FILE, or edit
# ~/.config/t3code/env independently on each remote machine.

T3CODE_PACKAGE="t3@nightly"

# Keep loopback for access through an SSH tunnel:
#   ssh -L 3773:127.0.0.1:3773 mac-mini
T3CODE_HOST="127.0.0.1"
T3CODE_PORT="3773"
T3CODE_CWD="${HOME}"

T3CODE_LOG_LEVEL="info"
T3CODE_BASE_DIR=""

# Optional override used by `t3code pair` when the public URL cannot be
# derived from Tailscale or T3CODE_HOST.
T3CODE_PUBLIC_URL=""

# "auto" uses private Tailnet HTTPS whenever Tailscale is connected and falls
# back to T3CODE_HOST otherwise. Use "true" to require Tailscale or "false" to
# always use the configured host directly.
T3CODE_TAILSCALE_SERVE="auto"
T3CODE_TAILSCALE_SERVE_PORT="443"
